# ============================================================
#  MaaUpdaterBat - .gitignore
# ============================================================

# ---- 运行期产物：绝不应入库 ----

# 本地 CA 与叶证书（含私钥！由 ghproxy/gen-certs.bat 生成）
ghproxy/certs/
*.key
*.crt
*.csr
*.srl

# 下载缓存与更新前备份（体积很大，保留在本地即可）
ghupdate/_cache/
ghupdate/_backup/

# 本机配置：含个人安装路径与镜像偏好，不入库（模板见 ghupdate/config.example.json）
ghupdate/config.json
ghupdate/config.json.tmp

# 代理 / 更新器的运行时文件
*.log
*.pid
ca_installed.flag
ghproxy.log

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# 虚拟环境
.venv/
venv/
ENV/
env/

# 测试 / 覆盖率
.tox/
.nox/
.coverage
.coverage.*
.cache
.pytest_cache/
.hypothesis/
htmlcov/

# ---- 编辑器 / IDE ----
.vscode/
.idea/
*.swp
*.swo
*~
*.iml
*.suo
*.user

# ---- 操作系统 ----
Thumbs.db
desktop.ini
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
.Spotlight-V100
.Trashes

# ---- 临时文件 ----
*.tmp
*.temp
*.bak
*.orig
*.rej
*~
