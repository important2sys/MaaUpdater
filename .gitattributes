# ============================================================
#  MaaUpdaterBat - .gitattributes
#  统一换行符，避免不同机器 clone 后行为不一致
# ============================================================

# 默认：仓库内统一 LF，检出时也保持 LF
* text=auto eol=lf

# Windows 批处理用 CRLF（cmd.exe 的原生格式）
*.bat text eol=crlf
*.cmd text eol=crlf

# 给最终用户看的纯文本说明也用 CRLF（会用记事本打开）
*.txt text eol=crlf

# PowerShell 脚本用 CRLF
*.ps1 text eol=crlf

# 二进制：不做任何换行转换
*.zip  binary
*.exe  binary
*.dll  binary
*.png  binary
*.jpg  binary
*.ico  binary
